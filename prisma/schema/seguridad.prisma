enum RolUsuario {
  ADMINISTRADOR
  AGRONOMO
  SUPERVISOR
  OPERADOR

  @@map("roles_usuario")
  @@schema("seguridad")
}

enum SexoUsuario {
  MASCULINO
  FEMENINO
  OTRO

  @@map("sexos_usuario")
  @@schema("seguridad")
}

enum EspecialidadAgricola {
  GENERAL
  PODADOR
  FUMIGADOR_APLICADOR
  REGADOR
  TRACTORISTA_MAQUINISTA
  COSECHADOR
  INJERTADOR

  @@map("especialidades_agricola")
  @@schema("seguridad")
}

model Usuario {
  id              String       @id @default(uuid(7)) @db.Uuid
  nombres         String       @map("nombres") @db.VarChar(100)
  apellidos       String       @map("apellidos") @db.VarChar(100)
  correo          String       @unique @map("correo") @db.VarChar(150)
  telefono        String?      @map("telefono") @db.VarChar(20)
  passwordHash    String       @map("password_hash") @db.VarChar(255)
  rol             RolUsuario   @default(ADMINISTRADOR) @map("rol")
  sexo            SexoUsuario? @map("sexo")
  fechaNacimiento DateTime?    @map("fecha_nacimiento") @db.Date
  direccion       String?      @map("direccion") @db.VarChar(255)

  // Datos específicos de trabajador / operario de campo
  codigoEmpleado  String?               @unique @map("codigo_empleado") @db.VarChar(50)
  numeroDocumento String?               @unique @map("numero_documento") @db.VarChar(20)
  especialidad    EspecialidadAgricola? @default(GENERAL) @map("especialidad")
  cuadrilla       String?               @map("cuadrilla") @db.VarChar(100)

  departamento    String?      @map("departamento") @db.VarChar(100)
  provincia       String?      @map("provincia") @db.VarChar(100)
  activo          Boolean      @default(true) @map("activo")

  // Relaciones
  parcelas                   Parcela[]
  actividadesComoResponsable ActividadAgricola[]   @relation("ActividadesResponsable")
  asignacionesActividad      ActividadTrabajador[] @relation("ActividadesTrabajador")

  // Auditoría Universal


  createdAt       DateTime     @default(now()) @map("created_at")
  createdBy       String?      @map("created_by") @db.Uuid
  updatedAt       DateTime     @updatedAt @map("updated_at")
  updatedBy       String?      @map("updated_by") @db.Uuid
  deletedAt       DateTime?    @map("deleted_at")
  version         Int          @default(1) @map("version")

  @@index([correo])
  @@map("usuarios")
  @@schema("seguridad")
}
